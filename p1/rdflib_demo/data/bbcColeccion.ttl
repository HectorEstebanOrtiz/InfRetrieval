    owl:sameAs <http://rdf.freebase.com/ns/m.0120y2kt>,
        ns39:Q18149176,
        wikidata:Q18149176 ;
    ns44:wasDerivedFrom "http://en.wikipedia.org/wiki/Jean_Hugues_Boutin?oldid=724826519" ;
