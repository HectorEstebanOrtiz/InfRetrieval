        dbpedia:Emma_Orczy,
        <http://dbpedia.org/resource/File:Carlota_Remfry.jpg>,
        <http://dbpedia.org/resource/File:Cementerio_inglés_de_Linares_(Jaén)_(4).jpg>,
        dbpedia:Gabriel_Miró,
        dbpedia:Henry_Bordeaux,
        <http://dbpedia.org/resource/Linares,_Jaén>,
        dbpedia:Marguerite_Audoux,
        dbpedia:Province_of_Jaén_\(Spain\),
        dbpedia:Regional_Government_of_Andalusia,
